{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/main.py": {
      "maxDuration": 10,
      "includeFiles": "{models/xgb_price_model.pkl,data/cleaned_flights_analysis.csv}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
